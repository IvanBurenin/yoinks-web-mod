{
  "name": "yoinks-web",
  "version": "0.4.0",
  "description": "Unofficial web UI fork of yoinks — queue, library, playlists, PWA and a local web server. Original CLI by Pablo Stanley.",
  "type": "module",
  "bin": {
    "yoinks": "dist/cli.js",
    "yoinks-web": "dist/server.js"
  },
  "files": [
    "dist",
    "web",
    "assets"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "quick": "node scripts/quick-start.mjs",
    "web": "tsx src/server.ts",
    "web:dev": "tsx watch src/server.ts",
    "web:start": "node dist/server.js",
    "test": "tsx --test src/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "start": "node dist/cli.js",
    "prepublishOnly": "npm test && npm run typecheck && npm run build"
  },
  "author": "vanombus (https://github.com/IvanBurenin); original by Pablo Stanley",
  "contributors": [
    {
      "name": "Pablo Stanley",
      "url": "https://github.com/pablostanley"
    }
  ],
  "keywords": [
    "video",
    "downloader",
    "yt-dlp",
    "youtube",
    "instagram",
    "twitter",
    "threads",
    "cli",
    "tui",
    "ink",
    "web",
    "pwa",
    "queue"
  ],
  "license": "MIT",
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "ink": "^7.1.0",
    "ink-select-input": "^6.2.0",
    "ink-spinner": "^5.0.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.7"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "tsup": "^8.5.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IvanBurenin/yoinks-web-mod.git"
  },
  "homepage": "https://github.com/IvanBurenin/yoinks-web-mod#readme",
  "bugs": {
    "url": "https://github.com/IvanBurenin/yoinks-web-mod/issues"
  }
}
